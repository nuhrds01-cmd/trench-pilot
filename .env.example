# Optional: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# App URL (used for docs / future webhooks)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43127

# Bot custody wallet (create with: npm run wallet:create)
